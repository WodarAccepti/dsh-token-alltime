{
  "name": "dsh-token-alltime",
  "version": "1.0.0",
  "description": "DSH 右侧悬浮卡片：历史（至昨日）+ 今日的 token 总量，按模型与最近 15 个使用日实时统计（平台账单导入 + 实时账本）。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "token",
    "usage",
    "token-usage"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "tools",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/smoke.mjs",
    "build:data": "node tools/build-data.mjs",
    "pack:release": "node tools/pack-release.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WodarAccepti/dsh-token-alltime.git"
  },
  "bugs": {
    "url": "https://github.com/WodarAccepti/dsh-token-alltime/issues"
  },
  "homepage": "https://github.com/WodarAccepti/dsh-token-alltime#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
